{
  "expo": {
    "name": "YojnaSetu",
    "slug": "yojnasetu-mobile",
    "scheme": "yojnasetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.yojnasetu.mobile"
    },
    "ios": {
      "supportsTablet": true
    }
  }
}
